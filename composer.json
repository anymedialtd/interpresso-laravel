{
    "name": "anymedialtd/interpresso-laravel",
    "description": "Interpresso translation management for Laravel localization.",
    "autoload": {
        "psr-4": {
            "AnyMedia\\Interpresso\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AnyMedia\\Interpresso\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Saverio Migale",
            "role": "Developer"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "laravel/legacy-factories": "^1.3",
        "openai-php/laravel": "^0.14.0",
        "orchestra/testbench": "^10.0||^11.0",
        "phpunit/phpunit": "^11.0||^12.0",
        "mockery/mockery": "^1.0.0",
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.0"
    },
    "suggest": {
        "openai-php/laravel": "Optional. Install to enable automatic translation with OpenAI."
    },
    "extra": {
        "laravel": {
            "providers": [
                "AnyMedia\\Interpresso\\InterpressoServiceProvider",
                "AnyMedia\\Interpresso\\InterpressoTranslatorServiceProvider"
            ]
        }
    },
    "license": "MIT",
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "hooks:install": "git config core.hooksPath .githooks && echo \"git hooks installed (.githooks)\"",
        "post-install-cmd": [
            "@hooks:install"
        ],
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --no-progress"
    }
}
